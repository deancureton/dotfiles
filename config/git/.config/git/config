[user]
	name = Dean Cureton
	email = 89793485+deancureton@users.noreply.github.com
[github]
	user = deancureton
[core]
	editor = nvim
	pager = delta
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	default = simple
	followTags = true
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	colorMoved = zebra
	algorithm = histogram
[alias]
	# Common shortcuts
	st = status
	co = checkout
	br = branch
	ci = commit
	unstage = reset HEAD --

	# Logging
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	last = log -1 HEAD

	# Diff shortcuts
	df = diff
	dc = diff --cached

	# Branch management
	branches = branch -a
	tags = tag -l
	remotes = remote -v

	# Undo
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[rebase]
	autoStash = true
[branch]
	sort = -committerdate
