{
  "env": {
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false"
  },
  "permissions": {
    "allow": [
      "Bash(lake build:*)",
      "mcp__lean-lsp",
      "WebSearch"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "lean4@lean4-skills": true,
    "mathlib-quality@mathlib-quality-plugins": true,
    "skill-creator@claude-plugins-official": true,
    "mqslim@mqslim-plugins": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "lean4-skills": {
      "source": {
        "source": "github",
        "repo": "cameronfreer/lean4-skills"
      },
      "autoUpdate": true
    },
    "mathlib-quality-plugins": {
      "source": {
        "source": "github",
        "repo": "CBirkbeck/mathlib-quality"
      }
    },
    "mqslim-plugins": {
      "source": {
        "source": "github",
        "repo": "CBirkbeck/MQSlim"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": false,
    "pr": false,
    "sessionUrl": false
  }
}
